<odoo>
  <record id="view_library_book_form" model="ir.ui.view">
    <field name="name">library.book.form</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
      <form>
        <header>
            <field name="state" widget="statusbar" options="{'clickable': 1}"/>
        </header>
        <sheet>
            <group>
                <field name="name"/>
                <field name="due_date"/>
            </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_library_book_list" model="ir.ui.view">
    <field name="name">library.book.list</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
      <list><field name="name"/><field name="state"/></list>
    </field>
  </record>

  <record id="action_library_book" model="ir.actions.act_window">
    <field name="name">Livres</field>
    <field name="res_model">library.book</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_library_root" name="Bibliothèque"/>
  <menuitem id="menu_library_book" parent="menu_library_root" action="action_library_book"/>
</odoo>
